# BGSIM 中继的全部配置项。复制成 .env 后按需改，再用
#   docker compose --env-file .env up -d
# 或直接 `set -a; . ./.env; set +a; node relay.mjs`。
# 命令行参数（--port / --host / ...）优先级高于环境变量。

# 监听端口 / 地址。部署时用 0.0.0.0；套了反向代理就改回 127.0.0.1。
PORT=8790
HOST=0.0.0.0

# 一桌几个真人（1-8）。不满的座位由客户端侧的引擎电脑补位。
NEED=8

# 一局最多几回合（引擎的 max_turns，会作为 config 下发给所有客户端）。
MAX_TURNS=60

# 选英雄阶段的时限（毫秒）。这个阶段不会代发动作，只会等。
HERO_SELECT_MS=90000

# 一局结束后房间保留多久（毫秒），留给晚到的重连拉最终状态。
ROOM_TTL_MS=300000

# 同时存在的房间上限 / 连接上限 / 单连接每秒消息上限（令牌桶）。
MAX_ROOMS=200
MAX_CLIENTS=512
RATE_PER_SEC=25
RATE_BURST=60

# 选填：设置后客户端必须用 wss://host/net?token=xxx 连接。
# RELAY_TOKEN=

# error | warn | info | debug
LOG_LEVEL=info
